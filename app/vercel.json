{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/generate-problems",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 12 * * 0"
    },
    {
      "path": "/api/cron/streak-freeze-monthly",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/study-minutes-reminder",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/monthly-budget-alert",
      "schedule": "0 0 * * *"
    }
  ],
  "functions": {
    "app/api/cron/generate-problems/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/weekly-digest/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/streak-freeze-monthly/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/study-minutes-reminder/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/monthly-budget-alert/route.ts": {
      "maxDuration": 60
    },
    "app/api/ai/coach/route.ts": {
      "maxDuration": 60
    }
  }
}
