# ============================================================
# HANEI - Environment Variables Template
# Copy this file to `.env.local` and fill in real values.
# Never commit .env.local to git.
# ============================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=HANEI

# --- Turso (libSQL) ---
# https://docs.turso.tech/sdk/ts/quickstart
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=

# --- Better Auth ---
# 32+ char random secret (e.g. `openssl rand -base64 32`)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- OpenAI (AI Coach + Moderation + TTS) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL_PRIMARY=gpt-5-mini
OPENAI_MODEL_FALLBACK=gpt-4.1-mini

# --- Anthropic (LLM-as-Judge cross-LLM verification) ---
# DEC-011: Claude Sonnet 4.5 で問題品質採点
ANTHROPIC_API_KEY=sk-ant-...

# --- Cloudflare R2 (Storage) ---
# https://developers.cloudflare.com/r2/api/s3/tokens/
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hanei-audio
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# --- Resend (Email) ---
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@hanei.app

# --- Sentry (Error Tracking) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=hanei
SENTRY_AUTH_TOKEN=

# Sentry runtime tuning (W12-T3-C / DEC-071)
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0
NEXT_PUBLIC_SENTRY_ENABLED=true
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENABLED=true

# --- Vercel (Analytics は zero config) ---
# (no env vars required)
