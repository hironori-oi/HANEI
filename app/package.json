{
  "name": "hanei",
  "version": "0.1.0",
  "private": true,
  "description": "HANEI (ハンエイ / 半英) - 小学生向け英語学習Webアプリ。半年で英検3級合格を目指す。",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-http-header-size=32768 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate-hotfix-0019": "tsx --env-file=.env.local scripts/migrate-0019-hotfix.ts",
    "db:migrate-hotfix-0019:dev": "tsx --env-file=.env.development.local scripts/migrate-0019-hotfix.ts",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ai:generate-problem": "tsx --env-file=.env.local scripts/generate-problem.ts",
    "ai:judge-problem": "tsx --env-file=.env.local scripts/judge-problem.ts",
    "ai:generate-explanations": "tsx --env-file=.env.local scripts/generate-explanations-w3.ts",
    "ai:generate-explanations:v5-vocab": "cross-env LEVEL_FILTER=eiken-5 SKILL_FILTER=vocab tsx --env-file=.env.local scripts/generate-explanations-w3.ts",
    "ai:generate-explanations:v5-grammar": "cross-env LEVEL_FILTER=eiken-5 SKILL_FILTER=grammar tsx --env-file=.env.local scripts/generate-explanations-w3.ts",
    "ai:generate-explanations:v5-listening": "cross-env LEVEL_FILTER=eiken-5 SKILL_FILTER=listening tsx --env-file=.env.local scripts/generate-explanations-w3.ts",
    "ai:generate-explanations:v5-reorder": "cross-env LEVEL_FILTER=eiken-5 SKILL_FILTER=reorder tsx --env-file=.env.local scripts/generate-explanations-w3.ts",
    "ai:generate-explanations:v4-vocab": "cross-env LEVEL_FILTER=eiken-4 SKILL_FILTER=vocab tsx --env-file=.env.local scripts/generate-explanations-w3.ts",
    "ai:generate-explanations:v4-grammar": "cross-env LEVEL_FILTER=eiken-4 SKILL_FILTER=grammar tsx --env-file=.env.local scripts/generate-explanations-w3.ts",
    "ai:generate-explanations:v4-listening": "cross-env LEVEL_FILTER=eiken-4 SKILL_FILTER=listening-response tsx --env-file=.env.local scripts/generate-explanations-w3.ts",
    "ai:generate-explanations:v4-reading": "cross-env LEVEL_FILTER=eiken-4 SKILL_FILTER=reading tsx --env-file=.env.local scripts/generate-explanations-w3.ts",
    "ai:generate-explanations:v3-vocab": "cross-env LEVEL_FILTER=eiken-3 SKILL_FILTER=vocab tsx --env-file=.env.local scripts/generate-explanations-w3.ts",
    "ai:generate-explanations:v3-reading": "cross-env LEVEL_FILTER=eiken-3 SKILL_FILTER=reading tsx --env-file=.env.local scripts/generate-explanations-w3.ts",
    "ai:generate-explanations:v3-writing": "cross-env LEVEL_FILTER=eiken-3 SKILL_FILTER=writing tsx --env-file=.env.local scripts/generate-explanations-w3.ts",
    "ai:generate-explanations:from-db": "tsx --env-file=.env.local scripts/generate-explanations-from-db.ts",
    "ai:generate-explanations:from-db:dry": "cross-env DRY_RUN=true tsx --env-file=.env.local scripts/generate-explanations-from-db.ts",
    "ai:generate-explanations:from-db:reading-3": "cross-env LEVEL_FILTER=eiken-3 SKILL_FILTER=reading-3 tsx --env-file=.env.local scripts/generate-explanations-from-db.ts",
    "ai:generate-explanations:from-db:listening-4": "cross-env LEVEL_FILTER=eiken-4 SKILL_FILTER=listening-4 tsx --env-file=.env.local scripts/generate-explanations-from-db.ts",
    "ai:generate-tts": "tsx --env-file=.env.local scripts/generate-tts-w3.ts",
    "ai:generate-tts-listening-3": "tsx --env-file=.env.local scripts/generate-tts-listening-3.ts",
    "ai:replace-problem": "tsx --env-file=.env.local scripts/replace-problem.ts",
    "r2:debug": "tsx --env-file=.env.local scripts/r2-debug.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed-problems-runner.ts",
    "db:apply-audio-urls-eiken3-listening": "tsx --env-file=.env.local scripts/apply-audio-urls-eiken3-listening.ts",
    "db:seed:dry": "cross-env DRY_RUN=true tsx --env-file=.env.local scripts/seed-problems-runner.ts",
    "db:seed:full": "cross-env SEED_LEVELS_SKILLS=1 tsx --env-file=.env.local scripts/seed-problems-runner.ts",
    "db:seed:dev": "tsx scripts/seed-dev-user.ts",
    "db:mirror:prod": "tsx scripts/mirror-prod-to-local.ts",
    "db:stats": "tsx --env-file=.env.local scripts/db-stats.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.0.0",
    "@anthropic-ai/sdk": ">=0.30.0 <1.0.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@heroicons/react": "^2.2.0",
    "@libsql/client": "^0.14.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.13",
    "@sentry/nextjs": "^10.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@vercel/analytics": "^1.4.1",
    "@vercel/speed-insights": "^1.1.0",
    "ai": "^4.0.0",
    "better-auth": "^1.1.18",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "next": "^16.0.0",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^4.0.0",
    "tailwind-merge": "^2.6.0",
    "ts-fsrs": "^4.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
